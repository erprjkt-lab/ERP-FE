{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(git branch *)",
      "Bash(find src *)",
      "Bash(grep -r * src/)",
      "Bash(grep -E \"^\\\\.env|^node_modules$|lock\")",
      "Bash(npm -v)",
      "Bash(node -e \"const p=require\\('d:/ERP-FE/node_modules/vite/package.json'\\);console.log\\(p.version, JSON.stringify\\(p.engines\\)\\)\")",
      "Bash(node -e \"console.log\\(require\\('d:/ERP-FE/node_modules/@rolldown/binding-win32-x64-msvc/package.json'\\).version\\)\")",
      "Bash(node -e \"console.log\\(require\\('d:/ERP-FE/node_modules/rolldown/package.json'\\).version\\)\")",
      "Bash(nvm list *)",
      "Bash(\"/c/nvm/nvm/v22.12.0/node.exe\" -v)"
    ],
    "deny": ["Bash(git push --force *)", "Bash(git reset --hard *)", "Bash(rm -rf *)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd /Users/abhisolanki/erp-app && npm run format 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '✅ Session ended. Remember to run /commit before pushing.'"
          }
        ]
      }
    ]
  }
}
